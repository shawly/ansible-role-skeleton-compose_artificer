---
# tasks file for {{ role_name }}

- name: Set facts block for {{ role_name }}
  tags:
    - {{ role_name }}
    - {{ role_name }}_migrate
    - {{ role_name }}_install
    - {{ role_name }}_run
    - {{ role_name }}_down
    - {{ role_name }}_destroy
    - compose_artificer
  block:
    - name: Pre-set facts hook for {{ role_name }}
      ansible.builtin.import_tasks: pre_set_facts.yml

    - name: Set facts for {{ role_name }}
      ansible.builtin.import_role:
        name: shawly.compose_artificer
        tasks_from: set_facts

    - name: Post-set facts hook for {{ role_name }}
      ansible.builtin.import_tasks: post_set_facts.yml

- name: Migrate block for {{ role_name }}
  tags:
    - {{ role_name }}
    - compose_artificer
    - {{ role_name }}_migrate
  block:
    - name: Pre-migrate hook for {{ role_name }}
      ansible.builtin.import_tasks: pre_migrate.yml

    - name: Migrate data from old location for {{ role_name }}
      ansible.builtin.import_role:
        name: shawly.compose_artificer
        tasks_from: migrate

    - name: Post-migrate hook for {{ role_name }}
      ansible.builtin.import_tasks: post_migrate.yml
  when: {{ role_name }}_migrate_dir is defined

- name: Install block for {{ role_name }}
  tags:
    - {{ role_name }}
    - compose_artificer
    - {{ role_name }}_install
  block:
    - name: Pre-install hook for {{ role_name }}
      ansible.builtin.import_tasks: pre_install.yml

    - name: Install files for {{ role_name }}
      ansible.builtin.import_role:
        name: shawly.compose_artificer
        tasks_from: install

    - name: Post-install hook for {{ role_name }}
      ansible.builtin.import_tasks: post_install.yml

- name: Run block for {{ role_name }}
  tags:
    - {{ role_name }}
    - compose_artificer
    - {{ role_name }}_run
  block:
    - name: Pre-run hook for {{ role_name }}
      ansible.builtin.import_tasks: pre_run.yml

    - name: Run services for {{ role_name }}
      ansible.builtin.import_role:
        name: shawly.compose_artificer
        tasks_from: run

    - name: Post-run hook for {{ role_name }}
      ansible.builtin.import_tasks: post_run.yml

# tear down with: ansible-playbook ... --tags {{ role_name }}_down
# the `never` tag ensures this only runs when the tag is explicitly requested
- name: Down block for {{ role_name }}
  tags:
    - never
    - {{ role_name }}_down
  block:
    - name: Pre-down hook for {{ role_name }}
      ansible.builtin.import_tasks: pre_down.yml

    - name: Shut down services for {{ role_name }}
      ansible.builtin.import_role:
        name: shawly.compose_artificer
        tasks_from: down

    - name: Post-down hook for {{ role_name }}
      ansible.builtin.import_tasks: post_down.yml
  when: '"{{ role_name }}_down" in ansible_run_tags'

# wipe with: ansible-playbook ... --tags {{ role_name }}_destroy
# the `never` tag ensures this only runs when the tag is explicitly requested
- name: Destroy block for {{ role_name }}
  tags:
    - never
    - {{ role_name }}_destroy
  block:
    - name: Pre-destroy hook for {{ role_name }}
      ansible.builtin.import_tasks: pre_destroy.yml

    - name: Destroy services and data for {{ role_name }}
      ansible.builtin.import_role:
        name: shawly.compose_artificer
        tasks_from: destroy

    - name: Post-destroy hook for {{ role_name }}
      ansible.builtin.import_tasks: post_destroy.yml
  when: '"{{ role_name }}_destroy" in ansible_run_tags'
